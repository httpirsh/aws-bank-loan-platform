# Copy to .env (gitignored) and fill in real values. Never commit .env.

# AWS credentials (use a scoped IAM user/role, not root)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# AWS resources used by the app
AWS_BUCKET_NAME=userfacesbucket
AWS_COLLECTION_NAME=userfaces
AWS_DYNAMO_TABLE_NAME=Users

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# RDS (PostgreSQL)
DB_NAME=db-loan-applications
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET_KEY=

# Step Functions
LOAN_WORKFLOW_STATE_MACHINE_ARN=arn:aws:states:us-east-1:<account-id>:stateMachine:Bank-Loan-Machine

# SNS
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:Notification
